# Copy to .env.local and fill in. .env.local is gitignored.
#
# Space ID + delivery/preview tokens:
#   Contentful web app -> Settings -> API keys -> (your key)
# Management token (only needed to run migrations, NOT by the Next.js app):
#   Settings -> API keys -> Content management tokens -> Generate personal token

CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=master

# Read published content. Safe to expose to a build; still keep it server-side.
CONTENTFUL_DELIVERY_TOKEN=

# Read draft/unpublished content, for the preview route.
CONTENTFUL_PREVIEW_TOKEN=

# Read/write EVERYTHING in the space, including deleting content types.
# Used only by `npm run migrate` and `npm run seed`. Never import this into app code.
CONTENTFUL_MANAGEMENT_TOKEN=

# Shared secret guarding the /api/preview route. Any long random string:
#   openssl rand -hex 32
CONTENTFUL_PREVIEW_SECRET=

# Which site "/" redirects to.
NEXT_PUBLIC_DEFAULT_SITE=meridian
